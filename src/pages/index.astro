---
import { App } from "../components/App";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>Aurelia · Night service</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <!--
      THESIS: The register is the tasting-menu book and the kitchen pass — photography sells the dish, the ticket is a live dupe, not a generic admin grid with food thumbs.
      OWN-WORLD: Night charcoal, ember copper, linen light mode; Geist chrome with Source Serif 4 dish names; high-contrast tablet density.
      STORY: A cashier builds a check, a manager reads the floor, both share one live ticket.
      FIRST VIEWPORT: Left 76px rail, plated menu grid, 380px guest check. Charge is the only loud control.
      FORM: Operate / tablet POS. Seed: brief-pinned shadcn + night service (no concept tournament).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <script is:inline>
      const stored = typeof localStorage !== "undefined" ? localStorage.getItem("theme") : null;
      const theme = stored || "dark";
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
    <App client:load />
  </body>
</html>
